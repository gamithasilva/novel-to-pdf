                    if (targetContentId === '#tab-reviews' && typeof window.initializeReviews === 'function') {
                        window.initializeReviews();
                    } else if (targetContentId === '#tab-comments' && typeof window.initializeComments === 'function') {
                        window.initializeComments();
                    }
                }
                const activeIndicator = alreadyActiveTab.querySelector('.tab-indicator');
                if (activeIndicator) activeIndicator.classList.remove('hidden');
            }
        }
    }

    initializeOfflineDownload();
});

function initializeOfflineDownload() {

    const storedUser = localStorage.getItem('user');
    if (!storedUser) {
        return; // Don't show offline button for non-authenticated users
    }

    // Wait for offline manager to be available
    if (typeof window.offlineManager === 'undefined') {
        loadOfflineManager().then(() => {
            setupDownloadButton();
        });
    } else {
        setupDownloadButton();
    }
}

function loadOfflineManager() {
    // Offline manager is now loaded in footer.php
    return new Promise((resolve) => {
        if (window.offlineManager) {
            resolve();
            return;
        }

        // Wait for offline manager to be available
        const checkInterval = setInterval(() => {
            if (window.offlineManager) {
                clearInterval(checkInterval);
                resolve();
            }
        }, 100);
    });
}
function isMobileView() {
    return window.innerWidth < 768; // md breakpoint
}

// Helper to get the correct action buttons container
function getActionButtonsContainer() {
    if (isMobileView()) {
        return document.getElementById('mobile-action-buttons');
    }
    return document.getElementById('desktop-action-buttons');
}
function setupDownloadButton() {
    // We need to handle BOTH containers since user might resize
    const desktopContainer = document.getElementById('desktop-action-buttons');
    const mobileContainer = document.getElementById('mobile-action-buttons');

    if (!desktopContainer && !mobileContainer) {
        // Fallback to old method
        const addToLibraryBtn = document.querySelector('.add-to-library-btn');
        if (!addToLibraryBtn) return;

        const downloadBtn = createDownloadButton('');
        const flexContainer = addToLibraryBtn.parentNode;
        flexContainer.parentNode.insertBefore(downloadBtn, flexContainer.nextSibling);
        checkDownloadStatus();
        setTimeout(() => initializeMangaStatus(), 100);
        return;
    }

    // Create buttons for both containers
    if (desktopContainer) {
        const desktopDownloadBtn = createDownloadButton('desktop');
        // Find the Read button to insert after its container
        const readBtn = desktopContainer.querySelector('#start-reading-btn');
        if (readBtn) {
            // Insert after the parent div of the read button (which contains read + library buttons)
            // Note: readBtn itself has .flex class, so we need the parent which is the row container
            const buttonRow = readBtn.parentElement;
            if (buttonRow && buttonRow.classList.contains('flex')) {
                buttonRow.after(desktopDownloadBtn);
            } else {
                desktopContainer.appendChild(desktopDownloadBtn);
            }
        } else {
            // Fallback to appending
            desktopContainer.appendChild(desktopDownloadBtn);
        }
    }

    if (mobileContainer) {
        const mobileDownloadBtn = createDownloadButton('mobile');
        // Find the Read button to insert after its container
        const readBtn = mobileContainer.querySelector('.mobile-start-reading-btn');
        if (readBtn) {
            // Insert after the parent div of the read button
            // Note: readBtn itself has .flex class, so we need the parent which is the row container
            const buttonRow = readBtn.parentElement;
            if (buttonRow && buttonRow.classList.contains('flex')) {
                buttonRow.after(mobileDownloadBtn);
            } else {
                mobileContainer.appendChild(mobileDownloadBtn);
            }
        } else {
            mobileContainer.appendChild(mobileDownloadBtn);
        }
    }

    // Check download status (will update all buttons)
    checkDownloadStatus();

    // Initialize manga status button
    setTimeout(() => initializeMangaStatus(), 100);
}


function createDownloadButton(variant = '') {
    const downloadBtn = document.createElement('button');
    const suffix = variant ? `-${variant}` : '';
    const isMobile = variant === 'mobile';

    downloadBtn.className = `offline-download-btn${suffix} w-full flex items-center justify-center gap-2 bg-neutral-500/10 hover:bg-neutral-500/30 text-neutral-400 px-4 ${isMobile ? 'py-2' : 'py-2.5'} rounded-lg font-medium transition-all duration-300 ${isMobile ? 'text-xs sm:text-sm' : 'text-sm'}`;
