window.addToListFromModal = async function (listId, mangaId, mangaTitle, listTitle) {
    const modal = document.getElementById('add-to-library-modal');

    try {
        const data = await window.mangaTaroAPI.request('/auth/list-items', {
            method: 'POST',
            body: JSON.stringify({
                list_id: listId,
                manga_id: mangaId
            })
        });

        if (data.success) {
            if (modal) modal.remove();
            showNotification(`Added "${mangaTitle}" to "${listTitle}"`, 'success');

            // Invalidate lists cache to reflect updated item count
            window.mangaTaroAPI.invalidateCache('/auth/lists');
        } else {
            // Handle specific error types with customized messages
            const errorType = data.error_type;
            let errorMessage;

            switch (errorType) {
                case 'already_exists':
                    errorMessage = `"${mangaTitle}" is already in "${listTitle}"`;
                    break;
                case 'limit_reached':
                    errorMessage = `List is full! "${listTitle}" has reached the maximum of 300 manga`;
                    break;
                case 'list_not_found':
                    errorMessage = `Could not find list "${listTitle}"`;
                    break;
                default:
                    errorMessage = data.message || 'Failed to add manga to list';
            }

            showNotification(errorMessage, 'error');
        }
    } catch (error) {
        console.error('Error adding to list:', error);

        // Check if error has data attached (from API response)
        if (error.data && error.data.error_type) {
            const errorType = error.data.error_type;
            let errorMessage;

            switch (errorType) {
                case 'already_exists':
                    errorMessage = `"${mangaTitle}" is already in "${listTitle}"`;
                    break;
                case 'limit_reached':
                    errorMessage = `List is full! "${listTitle}" has reached the maximum of 300 manga`;
                    break;
                case 'list_not_found':
                    errorMessage = `Could not find list "${listTitle}"`;
                    break;
                default:
                    errorMessage = error.data.message || error.message || 'Failed to add manga to list';
            }

            showNotification(errorMessage, 'error');
        } else {
            // Fallback for other errors
            showNotification(error.message || 'Failed to add to list', 'error');
        }
    }
};

