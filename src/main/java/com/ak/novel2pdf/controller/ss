    // Expose the addReadingHistory function globally
    window.addToHistory = async function (historyItem) {
        let localHistory = JSON.parse(localStorage.getItem('mangahistory')) || {};
        if (!historyItem.timestamp) {
            historyItem.timestamp = Date.now();
        }
        localHistory[historyItem.mangaId] = historyItem;

        let sortedHistory = Object.values(localHistory).sort((a, b) => b.timestamp - a.timestamp).slice(0, 15);
        let newHistory = {};
        sortedHistory.forEach(item => { newHistory[item.mangaId] = item; });
        localStorage.setItem('mangahistory', JSON.stringify(newHistory));

        if (isAuthenticated) {
            try {
                const response = await fetch('/auth/history', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    credentials: 'include',
                    body: JSON.stringify(historyItem)
                });

                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }

                return await response.json();
            } catch (error) {
                console.error('Error adding to server history:', error);
            }
        }

        return true;
    };

