    // Chapter loading system - DEFINE EARLY TO AVOID SCOPE ISSUES
    let chaptersLoaded = false;
    let currentOffset = 0;
    let currentOrder = 'DESC';
    let currentSearch = '';
    let currentGroupId = null;
    let hasMoreChapters = true;
    let isLoadingChapters = false;

    function loadChaptersIfNeeded() {
        if (!chaptersLoaded) {
            loadChapters(true);
        }
    }

    async function loadChapters(isInitial = false) {
        if (isLoadingChapters) return;
        if (!isInitial && !hasMoreChapters) return;

        isLoadingChapters = true;

        const chapterListContainer = document.querySelector('.chapter-list');
        if (!chapterListContainer) return;

        const mangaId = chapterListContainer.dataset.mangaId;
        const mangaStatus = chapterListContainer.dataset.status;
        if (!mangaId) return;

        // Show loader on initial load
        if (isInitial) {
            chapterListContainer.innerHTML = `
                <div class="chapter-loader flex items-center justify-center p-12">
                    <div class="flex flex-col items-center gap-3">
                        <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-orange-400"></div>
                        <span class="text-sm text-neutral-400">Loading chapters...</span>
                    </div>
                </div>
            `;
            currentOffset = 0;
        }

        try {
            // Generate anti-scraping token
            const { token, timestamp } = generateToken();

            const params = new URLSearchParams({
                manga_id: mangaId,
                offset: currentOffset,
                limit: 500,
                order: currentOrder,
                _t: token,
                _ts: timestamp
            });

            if (currentSearch) params.append('search', currentSearch);
            if (currentGroupId) params.append('group_id', currentGroupId);

            const response = await fetch(`/auth/manga-chapters?${params}`, {
                credentials: 'include'
            });

            if (!response.ok) throw new Error('Failed to load chapters');

            const data = await response.json();

            if (data.success) {
                renderChapters(data.chapters, isInitial, mangaStatus);
                hasMoreChapters = data.has_more;
                currentOffset += data.chapters.length;
                chaptersLoaded = true;

                // Mark read chapters after rendering
                if (isAuthenticated) {
                    setTimeout(() => markReadChapters(), 100);
                }
            }
        } catch (error) {
            console.error('Error loading chapters:', error);
            chapterListContainer.innerHTML = `
                <div class="p-8 text-center text-neutral-400">
                    <p>Failed to load chapters. Please try again.</p>
                </div>
            `;
        } finally {
            isLoadingChapters = false;
        }
    }

    function renderChapters(chapters, clearFirst, mangaStatus) {
        const chapterListContainer = document.querySelector('.chapter-list');
        if (!chapterListContainer) return;

        if (clearFirst) {
            chapterListContainer.innerHTML = '';
        }

        if (chapters.length === 0 && clearFirst) {
            chapterListContainer.innerHTML = '<p class="py-8 text-center text-neutral-500 text-sm">No chapters found.</p>';
            return;
        }

        const highestChapter = chapters[0]?.chapter || null;
        const existingCount = chapterListContainer.querySelectorAll('a').length;

        chapters.forEach((chapter, idx) => {
            const isLastChapter = mangaStatus === 'Completed' && chapter.chapter === highestChapter;
            const globalIndex = existingCount + idx; // For alternating rows
            const chapterHTML = createChapterHTML(chapter, isLastChapter, globalIndex);
            chapterListContainer.insertAdjacentHTML('beforeend', chapterHTML);
        });
