                // Check if server state differs from localStorage
                const localBookmarks = JSON.parse(localStorage.getItem('mangaLibrary')) || [];
                const isLocalBookmarked = localBookmarks.some(item => item.id === mangaId);

                // Only update if there's a mismatch (rare case)
