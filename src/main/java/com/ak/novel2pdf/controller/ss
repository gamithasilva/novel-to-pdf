// ===== CLAIM MANGA FUNCTIONALITY =====
// Only for users with role >= 4
document.addEventListener('DOMContentLoaded', function () {
    // Parse user data directly from localStorage
    let userData = null;
    try {
        const userStr = localStorage.getItem('user');
        if (userStr) {
            userData = JSON.parse(userStr);
        }
    } catch (e) {
        console.error('Error parsing user data:', e);
    }

    // Check if user has role >= 4
    if (!userData || !userData.role || userData.role < 4) {
        return; // Don't show claim button or make any API calls
    }

    const claimBtn = document.getElementById('claim-manga-btn');
    const claimBtnMobile = document.getElementById('claim-manga-btn-mobile');
    const claimModal = document.getElementById('claim-manga-modal');
    const closeModalBtn = document.getElementById('close-claim-manga-modal');
    const cancelBtn = document.getElementById('cancel-claim-manga');
    const submitBtn = document.getElementById('submit-claim-manga');
    const groupSelect = document.getElementById('claim-group-select');
    const messageDiv = document.getElementById('claim-manga-message');

    if ((!claimBtn && !claimBtnMobile) || !claimModal) return;

    // Show the claim button (user has role >= 4)
    if (claimBtn) claimBtn.style.display = 'flex';
    if (claimBtnMobile) claimBtnMobile.style.display = 'flex';

    // Open modal and load groups
    const handleClaimClick = async function () {
        openModal();
        await loadGroups();
    };

    if (claimBtn) claimBtn.addEventListener('click', handleClaimClick);
    if (claimBtnMobile) claimBtnMobile.addEventListener('click', handleClaimClick);

    // Close modal handlers
    closeModalBtn.addEventListener('click', closeModal);
    cancelBtn.addEventListener('click', closeModal);

    claimModal.addEventListener('click', function (e) {
        if (e.target === claimModal) {
            closeModal();
        }
    });

    // Submit claim
    submitBtn.addEventListener('click', async function () {
        await submitClaim();
    });

    function openModal() {
        claimModal.style.display = 'block';
        document.body.classList.add('overflow-hidden');

        setTimeout(() => {
            const modalContent = claimModal.querySelector('.bg-neutral-800');
            if (modalContent) {
                modalContent.classList.remove('scale-95', 'opacity-0');
                modalContent.classList.add('scale-100', 'opacity-100');
            }
        }, 10);

        // Clear previous message
        messageDiv.classList.add('hidden');
        messageDiv.textContent = '';
    }

    function closeModal() {
        const modalContent = claimModal.querySelector('.bg-neutral-800');
        if (modalContent) {
            modalContent.classList.remove('scale-100', 'opacity-100');
            modalContent.classList.add('scale-95', 'opacity-0');
        }

        setTimeout(() => {
            claimModal.style.display = 'none';
            document.body.classList.remove('overflow-hidden');
        }, 300);
    }

    async function loadGroups() {
        groupSelect.innerHTML = '<option value="">Loading groups...</option>';
        groupSelect.disabled = true;
        submitBtn.disabled = true;

        try {
            const data = await window.mangaTaroAPI.request('/auth/claim-manga', {
                method: 'GET'
            });

            if (data.success && data.groups && data.groups.length > 0) {
                groupSelect.innerHTML = '<option value="">Select a group...</option>';
                data.groups.forEach(group => {
                    const option = document.createElement('option');
                    option.value = group.id;
                    option.textContent = group.name;
                    groupSelect.appendChild(option);
                });
                groupSelect.disabled = false;
                submitBtn.disabled = false;
            } else {
                groupSelect.innerHTML = '<option value="">No groups available</option>';
                showMessage('You are not a member of any group. Please join a group first.', 'error');
            }
        } catch (error) {
            console.error('Error loading groups:', error);
            groupSelect.innerHTML = '<option value="">Error loading groups</option>';
            showMessage('Failed to load groups. Please try again.', 'error');
        }
    }

    async function submitClaim() {
        const selectedGroupId = groupSelect.value;

        if (!selectedGroupId) {
            showMessage('Please select a group', 'error');
            return;
        }

        const mangaId = document.body.dataset.mangaId;
        if (!mangaId) {
            showMessage('Manga ID not found', 'error');
            return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Claiming...';

        try {
            const data = await window.mangaTaroAPI.request('/auth/claim-manga', {
                method: 'POST',
                body: JSON.stringify({
                    manga_id: parseInt(mangaId),
                    group_id: parseInt(selectedGroupId)
                })
            });

            if (data.success) {
                showMessage(data.message || 'Manga claimed successfully!', 'success');

                // Hide claim button
                if (claimBtn) claimBtn.style.display = 'none';
                if (claimBtnMobile) claimBtnMobile.style.display = 'none';

                // Show toast notification
                if (window.showToast) {
                    window.showToast(data.message || 'Manga claimed successfully!', 'success');
                }

                // Close modal after 1.5 seconds
                setTimeout(() => {
                    closeModal();
                }, 1500);
            } else {
                showMessage(data.message || 'Failed to claim manga', 'error');
                submitBtn.disabled = false;
                submitBtn.textContent = 'Claim Manga';
            }
        } catch (error) {
            console.error('Error claiming manga:', error);
            showMessage(error.message || 'An error occurred. Please try again.', 'error');
            submitBtn.disabled = false;
            submitBtn.textContent = 'Claim Manga';
        }
    }

    function showMessage(text, type) {
        messageDiv.textContent = text;
        messageDiv.classList.remove('hidden', 'bg-red-500/20', 'text-red-400', 'bg-green-500/20', 'text-green-400');

        if (type === 'error') {
            messageDiv.classList.add('bg-red-500/20', 'text-red-400');
        } else {
            messageDiv.classList.add('bg-green-500/20', 'text-green-400');
        }
    }

    // Share functionality
    const shareBtn = document.getElementById('share-manga-btn');
    if (shareBtn) {
        shareBtn.addEventListener('click', async function () {
            const title = this.dataset.mangaTitle;
            const url = this.dataset.mangaUrl;

            // Check if Web Share API is supported (works on mobile and PWA)
            if (navigator.share) {
                try {
                    await navigator.share({
                        title: title,
                        text: `Check out ${title} on MangaTaro`,
                        url: url
                    });
                    ///console.log('Shared successfully');
                } catch (error) {
                    // User cancelled or error occurred
                    if (error.name !== 'AbortError') {
                        console.error('Error sharing:', error);
                        fallbackCopyToClipboard(url, shareBtn);
                    }
                }
            } else {
                // Fallback for desktop/browsers without Web Share API
                fallbackCopyToClipboard(url, shareBtn);
            }
        });
    }

    function fallbackCopyToClipboard(url, button) {
        // Try modern clipboard API first
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(() => {
                showShareFeedback(button);
            }).catch(() => {
                // Fallback to old method
                legacyCopyToClipboard(url, button);
            });
        } else {
            legacyCopyToClipboard(url, button);
        }
    }

    function legacyCopyToClipboard(url, button) {
        const textArea = document.createElement('textarea');
        textArea.value = url;
        textArea.style.position = 'fixed';
        textArea.style.left = '-999999px';
        textArea.style.top = '-999999px';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();

        try {
            document.execCommand('copy');
            showShareFeedback(button);
        } catch (error) {
            console.error('Failed to copy:', error);
            if (window.showToast) {
                window.showToast('Failed to copy link', 'error');
            }
        }

        document.body.removeChild(textArea);
    }

    function showShareFeedback(button) {
        const originalHTML = button.innerHTML;
        button.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
        `;
        button.classList.add('bg-orange-500/80');

        if (window.showToast) {
            window.showToast('Link copied to clipboard!', 'success');
        }

        setTimeout(() => {
            button.innerHTML = originalHTML;
            button.classList.remove('bg-orange-500/80');
        }, 2000);
    }
});

// ===== RATING BADGE & WRITE REVIEW BUTTONS =====
// Handle clicks from the manga header rating/review buttons
(function() {
    document.addEventListener('click', function(e) {
        // Find the reviews tab button - uses data-tab-target attribute
        const reviewsTabBtn = document.querySelector('[data-tab-target="#tab-reviews"]');
        if (!reviewsTabBtn) return;

        // Handle rating badge click - go to reviews tab
        const ratingBadge = e.target.closest('.rating-badge');
        if (ratingBadge && !ratingBadge.classList.contains('write-review-trigger')) {
            e.preventDefault();
            e.stopPropagation();
            reviewsTabBtn.click();
            // Scroll to tab content
            setTimeout(() => {
                const tabContent = document.querySelector('#tab-reviews');
                if (tabContent) {
                    tabContent.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }, 150);
            return;
        }

        // Handle write review button click - go to reviews tab and open modal
        const writeReviewBtn = e.target.closest('.write-review-trigger');
        if (writeReviewBtn) {
            e.preventDefault();
            e.stopPropagation();

            // Check if logged in first
            const isLoggedIn = typeof window.isAuthenticated === 'function'
                ? window.isAuthenticated()
                : !!localStorage.getItem('user');

            if (!isLoggedIn) {
                if (typeof window.openModal === 'function') {
                    window.openModal('loginModal');
                } else {
                    alert('Please log in to write a review');
                }
                return;
            }

            // Click the reviews tab
            reviewsTabBtn.click();

            // Wait for tab to switch and reviews to initialize, then open modal
            const tryOpenModal = (attempts = 0) => {
                if (attempts > 20) return; // Give up after 2 seconds

                // Check if reviewsSystem exists and has showReviewModal
                if (window.reviewsSystem && typeof window.reviewsSystem.showReviewModal === 'function') {
                    window.reviewsSystem.showReviewModal(!!window.reviewsSystem.userReview);
                    return;
                }

                // Also check for the write-review-btn inside the reviews tab
                const innerWriteBtn = document.querySelector('#tab-reviews .write-review-btn');
                if (innerWriteBtn) {
                    innerWriteBtn.click();
                    return;
                }

                // Try again
                setTimeout(() => tryOpenModal(attempts + 1), 100);
            };

            setTimeout(tryOpenModal, 200);
        }
    });
})();

