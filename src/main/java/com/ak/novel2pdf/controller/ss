function setupChapterSelectionEvents(isRedownload = false) {
    const modal = document.getElementById('chapter-selection-modal');
    if (!modal) return;

    const checkboxes = modal.querySelectorAll('.chapter-checkbox:not(:disabled)'); // Only enabled checkboxes
    const allCheckboxes = modal.querySelectorAll('.chapter-checkbox'); // All checkboxes for counting
    const selectedCount = modal.querySelector('#selected-count');
    const selectAllBtn = modal.querySelector('#select-all-chapters');
    const selectNoneBtn = modal.querySelector('#select-none-chapters');
    const selectLatestBtn = modal.querySelector('#select-latest-chapters');

    // Update selected count
    function updateSelectedCount() {
        const count = modal.querySelectorAll('.chapter-checkbox:checked').length;
        selectedCount.textContent = count;
    }

    // Add checkbox event listeners (only for enabled checkboxes)
    allCheckboxes.forEach(checkbox => {
        if (!checkbox.disabled) {
            checkbox.addEventListener('change', updateSelectedCount);
        }
    });

    // Select all button (only enabled chapters)
    selectAllBtn.addEventListener('click', () => {
        checkboxes.forEach(checkbox => {
            checkbox.checked = true;
        });
        updateSelectedCount();
    });

    // Select none button (only enabled chapters)
    selectNoneBtn.addEventListener('click', () => {
        checkboxes.forEach(checkbox => {
            checkbox.checked = false;
        });
        updateSelectedCount();
    });

    // Select latest 10 button (only enabled chapters)
    selectLatestBtn.addEventListener('click', () => {
        // First uncheck all enabled
        checkboxes.forEach(checkbox => {
            checkbox.checked = false;
        });

        // Select first 10 available (latest chapters are typically at the top)
        Array.from(checkboxes).slice(0, 10).forEach(checkbox => {
            checkbox.checked = true;
        });

        updateSelectedCount();
    });

    // Initialize count
    updateSelectedCount();
}

