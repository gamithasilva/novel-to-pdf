    // Function to get reading history from server or localStorage
    async function getReadingHistory(mangaId = null) {
        if (isAuthenticated) {
            try {
                const response = await fetch('/auth/history', {
                    method: 'GET',
                    credentials: 'include'
                });

                if (!response.ok) {
                    if (response.status === 401) {
                        isAuthenticated = false;
                        localStorage.removeItem('user');
                        const localHistory = JSON.parse(localStorage.getItem('mangahistory')) || {};
                        return mangaId ? localHistory[mangaId] : localHistory;
                    }
                    throw new Error('Network response was not ok');
                }

                const data = await response.json();
                const serverHistory = data.success ? data.data : {};
                return mangaId ? serverHistory[mangaId] : serverHistory;
            } catch (error) {
                console.error('Error fetching reading history:', error);
                const localHistory = JSON.parse(localStorage.getItem('mangahistory')) || {};
                return mangaId ? localHistory[mangaId] : localHistory;
            }
        } else {
            const localHistory = JSON.parse(localStorage.getItem('mangahistory')) || {};
            return mangaId ? localHistory[mangaId] : localHistory;
        }
    }

