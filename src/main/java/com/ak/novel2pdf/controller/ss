function initializeGallery() {
    const galleryGrid = document.querySelector('.gallery-grid');
    const galleryLoading = document.querySelector('.gallery-loading');

    if (!galleryGrid || !galleryLoading) return;

    // Show loading
    galleryLoading.classList.remove('hidden');
    galleryGrid.style.display = 'none';

    // Initialize lazy loading for gallery images
    const galleryItems = document.querySelectorAll('.gallery-item');
    let loadedImages = 0;
    const totalImages = galleryItems.length;

    if (totalImages === 0) {
        galleryLoading.classList.add('hidden');
        galleryGrid.style.display = 'block';
        return;
    }

    galleryItems.forEach((item, index) => {
        const img = item.querySelector('.lazy-load');
        const largeUrl = img.dataset.src;

        if (largeUrl) {
            // Create a new image to preload
            const preloadImg = new Image();
            preloadImg.onload = function () {
                img.src = largeUrl;
                img.classList.add('loaded');
                loadedImages++;

                // When all images are loaded, hide loading and show gallery
                if (loadedImages >= totalImages) {
                    galleryLoading.classList.add('hidden');
                    galleryGrid.style.display = 'block';
                }
            };
            preloadImg.onerror = function () {
                // If image fails to load, still count it as processed
                loadedImages++;
                img.style.background = '#374151';

                if (loadedImages >= totalImages) {
                    galleryLoading.classList.add('hidden');
                    galleryGrid.style.display = 'block';
                }
            };
            preloadImg.src = largeUrl;

            // Add click event for modal
            item.addEventListener('click', function () {
                openGalleryModal(index);
            });
        }
    });
}

let currentGalleryIndex = 0;
let galleryImages = [];

function openGalleryModal(index) {
    const modal = document.getElementById('gallery-modal');
    const modalImage = document.getElementById('modal-image');
    const modalCounter = document.getElementById('modal-counter');

    if (!modal || !modalImage) return;

    // Populate gallery images array
    galleryImages = Array.from(document.querySelectorAll('.gallery-item')).map(item => {
        const img = item.querySelector('.lazy-load');
        return {
            src: img.dataset.src,
            alt: img.alt
        };
    });

    currentGalleryIndex = index;
    updateModalImage();

    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    // Update counter
    if (modalCounter) {
        modalCounter.textContent = `${currentGalleryIndex + 1} / ${galleryImages.length}`;
    }
}

function closeGalleryModal() {
    const modal = document.getElementById('gallery-modal');
    if (modal) {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
    }
}

function nextImage() {
    if (currentGalleryIndex < galleryImages.length - 1) {
        currentGalleryIndex++;
        updateModalImage();
    }
}

function previousImage() {
    if (currentGalleryIndex > 0) {
        currentGalleryIndex--;
        updateModalImage();
    }
}

function updateModalImage() {
    const modalImage = document.getElementById('modal-image');
    const modalCounter = document.getElementById('modal-counter');

    if (modalImage && galleryImages[currentGalleryIndex]) {
        modalImage.src = galleryImages[currentGalleryIndex].src;
        modalImage.alt = galleryImages[currentGalleryIndex].alt;
    }

    if (modalCounter) {
        modalCounter.textContent = `${currentGalleryIndex + 1} / ${galleryImages.length}`;
    }
}

// Keyboard navigation for gallery modal
document.addEventListener('keydown', function (e) {
    const modal = document.getElementById('gallery-modal');
    if (!modal || modal.classList.contains('hidden')) return;

    switch (e.key) {
        case 'Escape':
            closeGalleryModal();
            break;
        case 'ArrowLeft':
            previousImage();
            break;
        case 'ArrowRight':
            nextImage();
            break;
    }
});

// Click outside to close modal
document.addEventListener('click', function (e) {
    const modal = document.getElementById('gallery-modal');
    if (e.target === modal) {
        closeGalleryModal();
    }
});

// Make functions global so they can be called from HTML
window.closeGalleryModal = closeGalleryModal;
window.nextImage = nextImage;
window.previousImage = previousImage;
// ==================== MANGA STATUS FUNCTIONALITY ====================
function initializeMangaStatus() {
    const storedUser = localStorage.getItem('user');
    if (!storedUser) return;

    const body = document.querySelector('body');
    const mangaId = body?.dataset.mangaId;
    if (!mangaId) return;

    let currentStatus = null;

    const statusConfig = {
        'reading': { label: 'Reading', bg: 'bg-blue-500/10', hover: 'hover:bg-blue-500/30', text: 'text-blue-400', svg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />' },
        'completed': { label: 'Completed', bg: 'bg-green-500/10', hover: 'hover:bg-green-500/30', text: 'text-green-400', svg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />' },
        'on_hold': { label: 'On Hold', bg: 'bg-yellow-500/10', hover: 'hover:bg-yellow-500/30', text: 'text-yellow-400', svg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" />' },
        'dropped': { label: 'Dropped', bg: 'bg-red-500/10', hover: 'hover:bg-red-500/30', text: 'text-red-400', svg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />' },
        'plan_to_read': { label: 'Plan to Read', bg: 'bg-purple-500/10', hover: 'hover:bg-purple-500/30', text: 'text-purple-400', svg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />' }
    };

    function createStatusButton(variant = '') {
        const container = document.createElement('div');
        const suffix = variant ? `-${variant}` : '';
        const isMobile = variant === 'mobile';

        container.className = `relative manga-status-container${suffix}`;

        let dropdownHTML = '';
        for (const [key, config] of Object.entries(statusConfig)) {
            dropdownHTML += `<button class="manga-status-option w-full text-left px-4 py-2 text-sm text-neutral-300 hover:bg-neutral-700 hover:${config.text} transition-colors" data-status="${key}"><span class="flex items-center gap-2"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">${config.svg}</svg>${config.label}</span></button>`;
        }

        const iconSize = isMobile ? 'w-4 h-4' : 'w-5 h-5';
        const pyClass = isMobile ? 'py-2' : 'py-2.5';
        const textSize = isMobile ? 'text-xs sm:text-sm' : 'text-sm';

        container.innerHTML = `
            <button id="manga-status-btn${suffix}" class="manga-status-btn w-full flex items-center justify-center gap-2 bg-neutral-500/10 hover:bg-neutral-500/30 text-neutral-400 px-4 ${pyClass} rounded-lg font-medium transition-all duration-300 ${textSize}" data-manga-id="${mangaId}">
                <span class="flex items-center gap-2">
                    <svg class="${iconSize}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                    </svg>
                    <span class="status-label">Set Status</span>
                </span>
                <svg class="w-4 h-4 transition-transform duration-200 dropdown-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
            </button>
            <div class="manga-status-dropdown hidden absolute left-0 bottom-full mb-2 w-full bg-neutral-800 border border-neutral-700 rounded-lg shadow-xl z-50">
                <div class="py-1">
                    ${dropdownHTML}
                    <div class="border-t border-neutral-700 mt-1 pt-1">
                        <button class="manga-status-clear w-full text-left px-4 py-2 text-sm text-neutral-500 hover:bg-neutral-700 hover:text-neutral-300 transition-colors">
                            <span class="flex items-center gap-2">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                Clear Status
                            </span>
                        </button>
                    </div>
                </div>
            </div>
        `;
        return container;
    }

    function updateAllButtonStates(status) {
        document.querySelectorAll('.manga-status-btn').forEach(btn => {
            const contentSpan = btn.querySelector('span.flex.items-center.gap-2');
            const svg = contentSpan?.querySelector('svg');
            const text = contentSpan?.querySelector('.status-label');

            if (status && statusConfig[status]) {
                const cfg = statusConfig[status];
                Object.values(statusConfig).forEach(c => btn.classList.remove(c.bg, c.hover, c.text));
                btn.classList.remove('bg-neutral-500/10', 'hover:bg-neutral-500/30', 'text-neutral-400');
                btn.classList.add(cfg.bg, cfg.hover, cfg.text);
                if (text) text.textContent = cfg.label;
                if (svg) svg.innerHTML = cfg.svg;
            } else {
                Object.values(statusConfig).forEach(c => btn.classList.remove(c.bg, c.hover, c.text));
                btn.classList.add('bg-neutral-500/10', 'hover:bg-neutral-500/30', 'text-neutral-400');
                if (text) text.textContent = 'Set Status';
                if (svg) svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />';
            }
        });

        // Update option highlighting
        document.querySelectorAll('.manga-status-option').forEach(opt => {
            const optCfg = statusConfig[opt.dataset.status];
            if (status && opt.dataset.status === status) {
                opt.classList.add(optCfg.bg.replace('/10', '/20'), optCfg.text);
            } else {
                Object.values(statusConfig).forEach(c => opt.classList.remove(c.bg.replace('/10', '/20'), c.text));
            }
        });
    }

    async function fetchStatus() {
        try {
            const res = await fetch(`/auth/manga-status?manga_id=${mangaId}`, { method: 'GET', credentials: 'include' });
            if (res.ok) {
                const data = await res.json();
                if (data.success && data.status) {
                    currentStatus = data.status;
                    updateAllButtonStates(data.status);
                }
            }
        } catch (e) {
            console.error('Error fetching status:', e);
        }
    }

    function setupEvents(container) {
        const btn = container.querySelector('.manga-status-btn');
        const dropdown = container.querySelector('.manga-status-dropdown');
        if (!btn || !dropdown) return;

        btn.addEventListener('click', e => {
            e.stopPropagation();
            // Close all other dropdowns first
            document.querySelectorAll('.manga-status-dropdown').forEach(d => {
                if (d !== dropdown) d.classList.add('hidden');
            });
            const isHidden = dropdown.classList.toggle('hidden');
            const arrow = btn.querySelector('.dropdown-arrow');
            if (arrow) {
                arrow.style.transform = isHidden ? 'rotate(0deg)' : 'rotate(180deg)';
            }
        });

        container.querySelectorAll('.manga-status-option').forEach(opt => {
            opt.addEventListener('click', async function () {
                const status = this.dataset.status;
                try {
                    const res = await fetch('/auth/manga-status', {
                        method: 'POST',
                        credentials: 'include',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ manga_id: parseInt(mangaId), status })
                    });
                    if (res.ok) {
                        const data = await res.json();
                        if (data.success) {
                            currentStatus = status;
                            updateAllButtonStates(status);
                            // Close all dropdowns
                            document.querySelectorAll('.manga-status-dropdown').forEach(d => d.classList.add('hidden'));
                            document.querySelectorAll('.dropdown-arrow').forEach(a => a.style.transform = 'rotate(0deg)');
                            showNotification(`Status set to ${statusConfig[status].label}`, 'success');
                        }
                    }
                } catch (e) {
                    console.error('Error:', e);
                    showNotification('Failed to update status', 'error');
                }
            });
        });

        const clearBtn = container.querySelector('.manga-status-clear');
        if (clearBtn) {
            clearBtn.addEventListener('click', async () => {
                try {
                    const res = await fetch(`/auth/manga-status?manga_id=${mangaId}`, { method: 'DELETE', credentials: 'include' });
                    if (res.ok) {
                        currentStatus = null;
                        updateAllButtonStates(null);
                        document.querySelectorAll('.manga-status-dropdown').forEach(d => d.classList.add('hidden'));
                        document.querySelectorAll('.dropdown-arrow').forEach(a => a.style.transform = 'rotate(0deg)');
                        showNotification('Status cleared', 'success');
                    }
                } catch (e) {
                    console.error('Error:', e);
                    showNotification('Failed to clear status', 'error');
                }
            });
        }
    }

    // Close dropdowns when clicking outside
    document.addEventListener('click', e => {
        if (!e.target.closest('.manga-status-container, .manga-status-container-desktop, .manga-status-container-mobile')) {
            document.querySelectorAll('.manga-status-dropdown').forEach(d => d.classList.add('hidden'));
            document.querySelectorAll('.dropdown-arrow').forEach(a => a.style.transform = 'rotate(0deg)');
        }
    });

    // Create status buttons for both containers
    const desktopContainer = document.getElementById('desktop-action-buttons');
    const mobileContainer = document.getElementById('mobile-action-buttons');

    if (desktopContainer) {
        const desktopStatusContainer = createStatusButton('desktop');
        // Insert before the claim button
        const claimBtn = desktopContainer.querySelector('#claim-manga-btn');
        if (claimBtn) {
            claimBtn.before(desktopStatusContainer);
        } else {
            desktopContainer.appendChild(desktopStatusContainer);
        }
        setupEvents(desktopStatusContainer);
    }

    if (mobileContainer) {
        const mobileStatusContainer = createStatusButton('mobile');
        // Insert before the claim button
        const claimBtnMobile = mobileContainer.querySelector('#claim-manga-btn-mobile');
        if (claimBtnMobile) {
            claimBtnMobile.before(mobileStatusContainer);
        } else {
            mobileContainer.appendChild(mobileStatusContainer);
        }
        setupEvents(mobileStatusContainer);
    }

    // Fallback for old layout
    if (!desktopContainer && !mobileContainer) {
        const offlineBtn = document.querySelector('.offline-download-btn');
        if (offlineBtn) {
            const statusContainer = createStatusButton('');
            offlineBtn.after(statusContainer);
            setupEvents(statusContainer);
        }
    }

    fetchStatus();
}

