// Anti-scraping token generator (GLOBAL SCOPE)
function generateToken() {
    const timestamp = Math.floor(Date.now() / 1000);
    const hour = new Date().toISOString().slice(0, 13).replace(/[-T:]/g, ''); // YYYYMMDDhh
    const secret = 'mng_ch_' + hour;
    const hash = md5(timestamp + secret).substring(0, 16);
    return { token: hash, timestamp: timestamp };
}

