// Toggle chapter menu dropdown
window.toggleChapterMenu = function (button) {
    const container = button.closest('.chapter-menu-container');
    if (!container) return;

    const dropdown = container.querySelector('.chapter-menu-dropdown');
    if (!dropdown) return;

    // Close all other open dropdowns first
    document.querySelectorAll('.chapter-menu-dropdown').forEach(d => {
        if (d !== dropdown) {
            d.classList.add('hidden');
        }
    });

    // Toggle this dropdown
    dropdown.classList.toggle('hidden');
};

// Mark chapter as read from menu
window.markChapterAsReadFromMenu = async function (chapterId, button) {
    const body = document.querySelector('body');
    const mangaId = body ? body.dataset.mangaId : null;

    if (!mangaId || !chapterId) {
        console.error('Missing manga ID or chapter ID');
        return;
    }

    // Check if user is authenticated
    const storedUser = localStorage.getItem('user');
    if (!storedUser) {
        showNotification('Please sign in to mark chapters as read', 'error');
        // Close the dropdown
        const dropdown = button.closest('.chapter-menu-dropdown');
        if (dropdown) dropdown.classList.add('hidden');
        return;
    }

    // Check localStorage cache first
    const cacheKey = `chapter_read_${chapterId}`;
    const cachedRead = localStorage.getItem(cacheKey);
    if (cachedRead && (Date.now() - parseInt(cachedRead)) < 86400000) {
        showNotification('Chapter already marked as read', 'success');
        // Close the dropdown
        const dropdown = button.closest('.chapter-menu-dropdown');
        if (dropdown) dropdown.classList.add('hidden');
        return;
    }

    try {
        const response = await fetch('/auth/chapters-read', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({
                manga_id: parseInt(mangaId),
                chapter_id: parseInt(chapterId)
            })
        });

        if (response.ok) {
            const data = await response.json();
            if (data.success) {
                // Cache the result
                localStorage.setItem(cacheKey, Date.now().toString());

                // Also save to mangahistory localStorage for history page display
                const bookmarkBtn = document.querySelector('[data-manga-cover]');
                const chapterLink = document.querySelector(`a[data-chapter-id="${chapterId}"]`);

                if (bookmarkBtn && chapterLink && window.addToHistory) {
                    const mangaName = document.querySelector('h1')?.textContent?.trim() || 'Unknown';
                    const coverUrl = bookmarkBtn.dataset.mangaCover;
                    const mangaUrl = bookmarkBtn.dataset.mangaUrl || window.location.href;
                    const chapterUrl = chapterLink.href;
                    const chapterText = chapterLink.textContent.trim();
                    const chapterMatch = chapterText.match(/Chapter\s+([\d.]+)/i);
                    const chapterNumber = chapterMatch ? chapterMatch[1] : '0';

                    window.addToHistory({
                        mangaId: mangaId,
                        mangaName: mangaName,
                        coverUrl: coverUrl,
                        mangaUrl: mangaUrl,
                        chapterId: chapterId,
                        chapterUrl: chapterUrl,
                        chapterNumber: chapterNumber,
                        timestamp: Date.now()
                    });
                }

                // Show success message
                const message = data.cached ? 'Chapter already marked as read' : 'Chapter marked as read';
                showNotification(message, 'success');

                // Update UI to show read indicator
                updateChapterReadIndicator(chapterId);

                // Close the dropdown
                const dropdown = button.closest('.chapter-menu-dropdown');
                if (dropdown) dropdown.classList.add('hidden');
            } else {
                showNotification('Failed to mark chapter as read', 'error');
            }
        } else {
            showNotification('Failed to mark chapter as read', 'error');
        }
    } catch (error) {
        console.error('Error marking chapter as read:', error);
        showNotification('Failed to mark chapter as read', 'error');
    }
};

// Update chapter to show read indicator
function updateChapterReadIndicator(chapterId) {
    const chapterLink = document.querySelector(`a[data-chapter-id="${chapterId}"]`);
    if (!chapterLink) return;

    // Check if indicator already exists
    if (chapterLink.querySelector('.read-indicator')) return;

    addReadIndicatorToChapter(chapterLink);

    // Add opacity to show it's read
    chapterLink.style.opacity = '0.65';
}

// Helper function to add read indicator to a chapter link
function addReadIndicatorToChapter(link) {
    const indicator = document.createElement('span');
    indicator.className = 'read-indicator inline-flex items-center';
    indicator.innerHTML = `
        <svg class="w-4 h-4 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
    `;
    indicator.title = 'Chapter read';

    // Mobile layout - find the chapter number container
    const mobileChapterContainer = link.querySelector('.sm\\:hidden .flex.items-center.gap-1\\.5');
    if (mobileChapterContainer) {
        const chapterSpan = mobileChapterContainer.querySelector('.font-medium');
        if (chapterSpan && !mobileChapterContainer.querySelector('.read-indicator')) {
            mobileChapterContainer.insertBefore(indicator.cloneNode(true), chapterSpan);
        }
    }

    // Desktop layout - find the main flex container with chapter info
    const desktopContainer = link.querySelector('.hidden.sm\\:flex > .flex.items-center.gap-2');
    if (desktopContainer) {
        const chapterSpan = desktopContainer.querySelector('.font-medium');
        if (chapterSpan && !desktopContainer.querySelector('.read-indicator')) {
            // Insert after the menu container, before the chapter span
            const menuContainer = desktopContainer.querySelector('.chapter-menu-container');
            if (menuContainer && menuContainer.nextSibling) {
                desktopContainer.insertBefore(indicator.cloneNode(true), menuContainer.nextSibling);
            }
        }
    }
}

