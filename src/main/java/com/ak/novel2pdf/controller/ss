async function checkDownloadStatus() {
    try {
        const body = document.querySelector('body');
        const mangaId = body.dataset.mangaId;

        if (!mangaId || !window.offlineManager) return;

        // Check if offline manager database is ready
        if (!window.offlineManager.db) {
            // Wait for database to be ready
            setTimeout(checkDownloadStatus, 500);
            return;
        }

        // Check if offline manager has the required methods before proceeding
        if (typeof window.offlineManager.getDownloadedManga !== 'function') {
            // Retry after a short delay if methods aren't ready yet
            setTimeout(checkDownloadStatus, 200);
            return;
        }

        const downloadedManga = await window.offlineManager.getDownloadedManga();
        const isDownloaded = downloadedManga.some(manga => manga.id === mangaId);

        updateDownloadButtonState(isDownloaded);
    } catch (error) {
        console.error('Error checking download status:', error);
        // Silently fail and show default state if there's an error
        updateDownloadButtonState(false);
    }
}

function updateDownloadButtonState(isDownloaded, isDownloading = false, progress = 0) {
    // Get all download buttons (desktop and mobile variants)
    const downloadBtns = document.querySelectorAll('[class*="offline-download-btn"]');

    downloadBtns.forEach(downloadBtn => {
        const isMobile = downloadBtn.className.includes('mobile');
        const iconSize = isMobile ? 'h-4 w-4' : 'h-5 w-5';
        const pyClass = isMobile ? 'py-2' : 'py-2.5';
        const textSize = isMobile ? 'text-xs sm:text-sm' : 'text-sm';
        const baseClasses = `w-full flex items-center justify-center gap-2 px-4 ${pyClass} rounded-lg font-medium ${textSize}`;

        // Preserve the variant class
        const variantClass = isMobile ? 'offline-download-btn-mobile' : (downloadBtn.className.includes('desktop') ? 'offline-download-btn-desktop' : 'offline-download-btn');

        if (isDownloading) {
            downloadBtn.className = `${variantClass} ${baseClasses} bg-orange-500/20 text-orange-400 cursor-not-allowed`;
            downloadBtn.innerHTML = `
                <svg class="animate-spin ${iconSize}" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span>Downloading... ${progress}%</span>
            `;
            downloadBtn.disabled = true;
        } else if (isDownloaded) {
            downloadBtn.className = `${variantClass} ${baseClasses} bg-orange-500/10 hover:bg-orange-500/30 text-orange-400 transition-all duration-300`;
            downloadBtn.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" class="${iconSize}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Available Offline</span>
            `;
            downloadBtn.disabled = false;
        } else {
            downloadBtn.className = `${variantClass} ${baseClasses} bg-neutral-500/10 hover:bg-neutral-500/30 text-neutral-400 transition-all duration-300`;
            downloadBtn.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" class="${iconSize}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span>Read Offline</span>
            `;
            downloadBtn.disabled = false;
        }
    });
}

async function handleDownloadClick(event) {
    event.preventDefault();

    const body = document.querySelector('body');
    const mangaId = body.dataset.mangaId;

    if (!mangaId || !window.offlineManager) {
        alert('Download functionality not available');
        return;
    }

    try {
        // Check if already downloaded
        const downloadedManga = await window.offlineManager.getDownloadedManga();
        const isDownloaded = downloadedManga.some(manga => manga.id === mangaId);

        if (isDownloaded) {
            // Show options: read offline or re-download
            showDownloadedMangaOptions(mangaId);
            return;
        }

        // Check download limit (5 manga maximum)
        if (downloadedManga.length >= 5) {
            showDownloadLimitModal();
            return;
        }

        // Check if currently downloading
        if (window.offlineManager.downloadQueue.has(mangaId)) {
            alert('This manga is already being downloaded');
            return;
        }

        // Show chapter selection modal
        showChapterSelectionModal(mangaId);

    } catch (error) {
        console.error('Download failed:', error);
        alert(`Download failed: ${error.message}`);
    }
}

