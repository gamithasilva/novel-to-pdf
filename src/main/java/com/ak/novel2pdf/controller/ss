function monitorDownloadProgress(mangaId) {
    const progressModal = document.getElementById('download-progress-modal');
    if (!progressModal) return;

    const progressBar = progressModal.querySelector('.progress-bar');
    const progressText = progressModal.querySelector('.progress-text');
    const progressPercentage = progressModal.querySelector('.progress-percentage');
    const chaptersDownloaded = progressModal.querySelector('.chapters-downloaded');
    const chaptersTotal = progressModal.querySelector('.chapters-total');
    const downloadStatus = progressModal.querySelector('.download-status');

    const updateInterval = setInterval(() => {
        if (!window.offlineManager || !window.offlineManager.downloadQueue.has(mangaId)) {
            clearInterval(updateInterval);
            return;
        }

        const downloadInfo = window.offlineManager.downloadQueue.get(mangaId);

        // Update progress bar and button
        if (progressBar) progressBar.style.width = `${downloadInfo.progress}%`;
        if (progressPercentage) progressPercentage.textContent = `${downloadInfo.progress}%`;
        if (chaptersDownloaded) chaptersDownloaded.textContent = downloadInfo.downloadedChapters;
        if (chaptersTotal) chaptersTotal.textContent = downloadInfo.totalChapters;
        if (downloadStatus) downloadStatus.textContent = downloadInfo.status;

        // Update button state
        updateDownloadButtonState(false, true, downloadInfo.progress);

        if (progressText) {
            if (downloadInfo.status === 'downloading') {
                progressText.textContent = `Downloading chapters (${downloadInfo.downloadedChapters}/${downloadInfo.totalChapters})`;
            } else if (downloadInfo.status === 'completed') {
                progressText.textContent = 'Download completed!';
                clearInterval(updateInterval);
                // Update button to show "Available Offline" when complete
                updateDownloadButtonState(true, false, 100);
                setTimeout(() => hideDownloadProgress(), 2000);
            } else if (downloadInfo.status === 'failed') {
                progressText.textContent = `Download failed: ${downloadInfo.error}`;
                // Update button back to "Read Offline" when failed
                updateDownloadButtonState(false, false, 0);
                clearInterval(updateInterval);
            }
        }
    }, 1000);
}

function hideDownloadProgress() {
    const progressModal = document.getElementById('download-progress-modal');
    if (progressModal) {
        progressModal.remove();
    }
}

// Global function for starting selected chapter download
window.startSelectedDownload = async function (mangaId, isRedownload = false) {
    const modal = document.getElementById('chapter-selection-modal');
    if (!modal) return;

    const selectedCheckboxes = modal.querySelectorAll('.chapter-checkbox:checked');

    if (selectedCheckboxes.length === 0) {
        alert('Please select at least one chapter to download');
        return;
    }

    const selectedChapters = Array.from(selectedCheckboxes).map(checkbox => {
        const label = checkbox.closest('.chapter-item')?.querySelector('label');
        const titleElement = label?.querySelector('.text-neutral-400');

        return {
            number: checkbox.dataset.chapterNumber,
            url: checkbox.dataset.chapterUrl,
            title: titleElement?.textContent?.trim() || ''
        };
    });

    const mangaTitle = document.querySelector('h1')?.textContent || 'Unknown Manga';
    const actionText = isRedownload ? 'add' : 'download';

    if (!confirm(`${isRedownload ? 'Add' : 'Download'} ${selectedChapters.length} selected chapters ${isRedownload ? 'to' : 'from'} "${mangaTitle}"?\n\nThis may take several minutes and use significant storage space.`)) {
        return;
    }

    // Close modal
    modal.remove();

    try {
        // Update button state
        updateDownloadButtonState(false, true, 0);
        showDownloadProgress(mangaId, mangaTitle);

        if (isRedownload) {
            // Add additional chapters to existing download
            await downloadAdditionalChapters(mangaId, selectedChapters);
        } else {
            // Start fresh selective download
            await downloadSelectedChapters(mangaId, selectedChapters);
        }

        // Download completed
        updateDownloadButtonState(true, false, 100);
        hideDownloadProgress();

    } catch (error) {
        console.error('Download failed:', error);
        hideDownloadProgress();
        updateDownloadButtonState(false, false, 0);
        alert(`Download failed: ${error.message}`);
    }
};

async function downloadSelectedChapters(mangaId, selectedChapters) {
    if (!window.offlineManager) {
        throw new Error('Offline manager not available');
    }

    // Get manga data first (metadata only, chapters will be built from selected)
    const mangaData = await window.offlineManager.getMangaData(mangaId);
    if (!mangaData) {
        throw new Error('Could not fetch manga data');
    }

    // Build chapter objects from selected chapters (which already have URLs from the API)
    const filteredChapters = selectedChapters.map(selected => ({
        id: window.offlineManager.extractChapterIdFromUrl(selected.url),
        url: selected.url,
        title: selected.title || '',
        chapterNumber: selected.number,
        mangaId: mangaId
    }));

    // Update manga data with filtered chapters
    mangaData.chapters = filteredChapters;

    const downloadInfo = {
        mangaId,
        status: 'initializing',
        progress: 0,
        totalChapters: filteredChapters.length,
        downloadedChapters: 0,
        failedChapters: [],
        startTime: Date.now(),
        manga: mangaData
    };

    window.offlineManager.downloadQueue.set(mangaId, downloadInfo);
    await window.offlineManager.updateDownloadProgress(mangaId, downloadInfo);

    // Download cover image first
    if (mangaData.cover) {
        await window.offlineManager.cacheCoverImage(mangaId, mangaData.cover);
    }

    await window.offlineManager.saveMangaMetadata(mangaData);

    window.offlineManager.showNotification('Download Started', `Downloading ${filteredChapters.length} chapters from "${mangaData.title}"`, 'info');

    // Download selected chapters
    await window.offlineManager.downloadChaptersBatch(mangaId, filteredChapters);

    downloadInfo.status = 'completed';
    downloadInfo.progress = 100;
    downloadInfo.completedTime = Date.now();
    await window.offlineManager.updateDownloadProgress(mangaId, downloadInfo);

    window.offlineManager.showNotification('Download Complete', `Selected chapters from "${mangaData.title}" are now available offline`, 'success');
}

async function downloadAdditionalChapters(mangaId, selectedChapters) {
    if (!window.offlineManager) {
        throw new Error('Offline manager not available');
    }

    // Get manga data first (metadata only, chapters will be built from selected)
    const mangaData = await window.offlineManager.getMangaData(mangaId);
    if (!mangaData) {
        throw new Error('Could not fetch manga data');
    }

    // Get already downloaded chapters
    const existingChapters = await window.offlineManager.getMangaChapters(mangaId);
    const existingChapterNumbers = existingChapters.map(ch => ch.chapterNumber);

    // Build chapter objects from selected chapters that aren't already downloaded
    const newChaptersToDownload = selectedChapters
        .filter(selected => !existingChapterNumbers.includes(selected.number))
        .map(selected => ({
            id: window.offlineManager.extractChapterIdFromUrl(selected.url),
            url: selected.url,
            title: selected.title || '',
            chapterNumber: selected.number,
            mangaId: mangaId
        }));

    if (newChaptersToDownload.length === 0) {
        throw new Error('No new chapters to download (all selected chapters are already downloaded)');
    }

    const downloadInfo = {
        mangaId,
        status: 'initializing',
        progress: 0,
        totalChapters: newChaptersToDownload.length,
        downloadedChapters: 0,
        failedChapters: [],
        startTime: Date.now(),
        manga: mangaData
    };

    window.offlineManager.downloadQueue.set(mangaId, downloadInfo);
    await window.offlineManager.updateDownloadProgress(mangaId, downloadInfo);

    window.offlineManager.showNotification('Download Started', `Downloading ${newChaptersToDownload.length} additional chapters from "${mangaData.title}"`, 'info');

    // Download new chapters only
    await window.offlineManager.downloadChaptersBatch(mangaId, newChaptersToDownload);

    downloadInfo.status = 'completed';
    downloadInfo.progress = 100;
    downloadInfo.completedTime = Date.now();
    await window.offlineManager.updateDownloadProgress(mangaId, downloadInfo);

    window.offlineManager.showNotification('Download Complete', `${newChaptersToDownload.length} additional chapters added to "${mangaData.title}"`, 'success');
}

